with "../core/attest_sha256.gpr";
project Canonical_Exchange_Tests is
   for Source_Dirs use (".", "../core");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("canonical_exchange_controls.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnatVa", "-gnatf", "-gnata", "-O2", "-g");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=3", "--report=all", "-j2");
   end Prove;
end Canonical_Exchange_Tests;
