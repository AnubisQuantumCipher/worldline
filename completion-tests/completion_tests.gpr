with "../core/worldline_core_sources.gpr";
project Completion_Tests is
   for Source_Dirs use (".");
   for Object_Dir use "../obj/completion-tests";
   for Exec_Dir use "../obj/completion-tests";
   for Main use ("test_completion.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnatf", "-O2", "-g", "-gnata");
   end Compiler;
end Completion_Tests;
