[Unit]
Description=WORLDLINE branchable reality daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/worldlined
Restart=on-failure
RestartSec=2
RuntimeDirectory=worldline
RuntimeDirectoryMode=0700
UMask=0077

[Install]
WantedBy=graphical-session.target
