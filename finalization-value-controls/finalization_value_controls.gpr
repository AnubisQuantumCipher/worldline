with "../core/worldline_core_sources.gpr";
project Finalization_Value_Controls is
   for Source_Dirs use (".");
   for Object_Dir use "../obj/finalization-value-controls";
   for Exec_Dir use "../bin";
   for Main use ("test_finalization_values.adb", "test_finalization_parent_values.adb",
                 "test_finalization_projection.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnatf", "-O2", "-g", "-gnata");
   end Compiler;
end Finalization_Value_Controls;
