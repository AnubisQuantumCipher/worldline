      ],
      "id": "W1-V6-IMAGE-PIN",
      "reason": "The image-directory exact entry-set check was removed from per-use pins. Setup and rollback captures do not satisfy the sealed correction's requirement to preserve every-use comparison."
    },
    {
      "evidence": [
        "ISOLATION-STORAGE-PROPOSAL-v6.md:1548",
        "ISOLATION-STORAGE-PROPOSAL-v6.md:1557",
        "ISOLATION-STORAGE-PROPOSAL-v6.md:4520"
