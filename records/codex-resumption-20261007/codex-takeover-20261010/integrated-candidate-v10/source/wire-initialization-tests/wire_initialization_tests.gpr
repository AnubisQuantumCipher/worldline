with "../core/worldline_core_sources.gpr";
project Wire_Initialization_Tests is
   for Source_Dirs use (".");
   for Source_Files use ("test_wire_initialization.adb");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("test_wire_initialization.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnatf", "-O2", "-g", "-fPIC", "-gnata");
   end Compiler;
end Wire_Initialization_Tests;
