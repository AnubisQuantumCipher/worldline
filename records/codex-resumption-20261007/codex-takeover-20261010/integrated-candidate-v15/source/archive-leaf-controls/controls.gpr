with "../core/worldline_core_sources.gpr";
project Archive_Leaf_Controls is
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "../obj/archive-leaf-controls";
   for Exec_Dir use "../obj/archive-leaf-controls";
   for Main use ("archive_leaf_controls.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-g", "-O0");
   end Compiler;
end Archive_Leaf_Controls;
