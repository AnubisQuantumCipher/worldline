with "../core/worldline_core_sources.gpr";
project Explicit_Recovery_Marker_Tests is
   for Source_Dirs use (".");
   for Source_Files use ("test_explicit_recovery_markers.adb");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("test_explicit_recovery_markers.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnatf", "-O2", "-g", "-fPIC", "-gnata");
   end Compiler;
end Explicit_Recovery_Marker_Tests;
