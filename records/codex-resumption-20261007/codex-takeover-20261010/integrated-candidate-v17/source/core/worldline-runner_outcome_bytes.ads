--  allocation-sized domain restriction or status/success flag authority.
--  Native requests original publications, list(argv) before status protocols,
--  and the remaining agent-result construction before later reason callbacks.
--  runner-owner-v1 requires both actual prefix and result materializations.
--  policy-only-v1 is a control profile without an original result owner, not
--  production retained evaluation authority. COMPLETE ceiling fields audit
--  initial native derivation; the caller MUST NOT reassign the published fields.
package Worldline.Runner_Outcome_Bytes with SPARK_Mode is
   package E renames Worldline.Archive_Envelope;
   function Decide (Data : E.Bytes; Capture : E.Span) return String
     with Global => null;
end Worldline.Runner_Outcome_Bytes;
