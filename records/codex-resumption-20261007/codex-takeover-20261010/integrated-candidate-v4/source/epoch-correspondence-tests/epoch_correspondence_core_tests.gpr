with "../core/worldline_core.gpr";
project Epoch_Correspondence_Core_Tests is
   for Source_Dirs use (".");
   for Object_Dir use "../obj/epoch-correspondence-core-tests";
   for Exec_Dir use "../bin/epoch-correspondence-core";
   for Main use ("test_epoch_correspondence.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnatf", "-O2", "-g", "-gnata");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use
        ("-Wl,-rpath,$ORIGIN/../../lib", "-Wl,-rpath,$ORIGIN/../../pending-component/lib");
   end Linker;
end Epoch_Correspondence_Core_Tests;
