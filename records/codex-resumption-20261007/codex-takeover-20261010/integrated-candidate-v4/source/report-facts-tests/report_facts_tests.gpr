with "../core/worldline_core_sources.gpr";
project Report_Facts_Tests is
   for Source_Dirs use (".");
   for Object_Dir use "../obj/report-facts-tests";
   for Exec_Dir use "../obj/report-facts-tests";
   for Main use ("test_report_facts.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnatf", "-O2", "-g", "-gnata");
   end Compiler;
end Report_Facts_Tests;
