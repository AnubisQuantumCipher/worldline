with "../core/worldline_core.gpr";
project Resources_Prefix_Correspondence_Tests is
   for Source_Dirs use (".");
   for Object_Dir use "../obj/resources-prefix-correspondence-tests";
   for Exec_Dir use "../bin/resources-prefix-correspondence-tests";
   for Main use ("test_resources_prefix_correspondence.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnatf", "-O2", "-g", "-gnata");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-Wl,-rpath,$ORIGIN/../../lib");
   end Linker;
end Resources_Prefix_Correspondence_Tests;
