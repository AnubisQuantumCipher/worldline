with "../core/worldline_core.gpr";
project Resource_Policy_Smoke is
   for Source_Dirs use (".");
   for Source_Files use ("resource_policy_smoke.adb");
   for Object_Dir use "../obj/policy-smoke";
   for Exec_Dir use "../bin";
   for Main use ("resource_policy_smoke.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnatf", "-O2", "-g", "-gnata");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-Wl,-rpath,$ORIGIN/../lib");
   end Linker;
end Resource_Policy_Smoke;
