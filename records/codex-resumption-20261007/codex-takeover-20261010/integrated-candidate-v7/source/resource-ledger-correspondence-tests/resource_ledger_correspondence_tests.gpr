with "../core/worldline_core.gpr";
project Resource_Ledger_Correspondence_Tests is
   for Source_Dirs use (".");
   for Object_Dir use "../obj/resource-ledger-correspondence-tests";
   for Exec_Dir use "../bin/resource-ledger-correspondence-tests";
   for Main use ("test_resource_ledger_correspondence.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnatf", "-O2", "-g", "-gnata");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-Wl,-rpath,$ORIGIN/../../lib");
   end Linker;
end Resource_Ledger_Correspondence_Tests;
