with "../core/worldline_core_sources.gpr";
project Archive_Envelope_Controls is
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "../obj/archive-envelope-controls";
   for Exec_Dir use "../obj/archive-envelope-controls";
   for Main use ("archive_envelope_controls.adb", "scoped_archive_controls.adb", "archive_hmac_join_controls.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-g", "-O0");
   end Compiler;
end Archive_Envelope_Controls;
