with Worldline.Retained_Evidence_Replay;
with Interfaces;
package Retained_Replay_Controls with SPARK_Mode is
   package R renames Worldline.Retained_Evidence_Replay;
   package E renames R.E;
   type Expectation is (Match, Decode_Refused, Output_Conflict, Not_Jointly_Matched);
   type Control is record
      Observation, Material : E.Span;
      Expected : Expectation;
   end record;
   type Controls is array (E.Q.Byte_Index range <>) of Control;
   -- Parent supplies genuine archived original fixture operands, generated by
   -- retained_evidence_replay_controls.py. No fixture or control is executed by
   -- merely enrolling this source. Full original roster remains mandatory.
   procedure Assert_Root_Controls
     (Data : E.Bytes; Faithful_Observation, Faithful_Material : E.Span;
      Expected_Status : R.J.Status; Cases : Controls) with Global => null;
   procedure Assert_Scoped_Controls
     (Data : E.Bytes; Faithful_Observation, Faithful_Material : E.Span;
      Expected_Entry : R.Scoped_Entry; Expected_Status : Interfaces.Unsigned_32;
      Cases : Controls) with Global => null;
   procedure Assert_Operation_Controls
     (Data : E.Bytes; Faithful_Observation, Faithful_Material : E.Span;
      Expected_Command : R.A.Command; Expected_Status : R.A.Decision;
      Cases : Controls) with Global => null;
   procedure Assert_Historical_Controls
     (Data : E.Bytes; Faithful_Observation, Faithful_Material : E.Span;
      Expected_Status : R.H.Decision; Cases : Controls) with Global => null;
   procedure Assert_Exchange_Controls
     (Data : E.Bytes; Faithful_Observation, Faithful_Material : E.Span;
      Expected_Status : R.CEX.Decision; Cases : Controls) with Global => null;
   procedure Assert_Reservation_Controls
     (Data : E.Bytes; Faithful_Observation, Faithful_Material : E.Span;
      Expected_Status : R.A.Decision; Cases : Controls) with Global => null;
   procedure Assert_Image_Control
     (Data : E.Bytes; Image, Value : E.Span;
      Image_Scoped, Value_Scoped, Carrier_Scoped, Expected : Boolean) with Global => null;
end Retained_Replay_Controls;
