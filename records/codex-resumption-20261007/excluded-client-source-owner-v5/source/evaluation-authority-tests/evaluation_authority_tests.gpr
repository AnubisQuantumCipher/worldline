with "../core/worldline_core_sources.gpr";
project Evaluation_Authority_Tests is
   for Source_Dirs use (".");
   for Object_Dir use "../obj/evaluation-authority-tests";
   for Exec_Dir use "../obj/evaluation-authority-tests";
   for Main use ("test_evaluation_authority.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnatf", "-O2", "-g", "-gnata");
   end Compiler;
end Evaluation_Authority_Tests;
