with "../core/worldline_core.gpr";
project Tests is
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "../obj/evaluation-history-tests";
   for Exec_Dir use "../obj/evaluation-history-tests";
   for Main use ("test_history.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-g", "-O0");
   end Compiler;
end Tests;
