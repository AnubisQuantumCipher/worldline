project Worldline_Attest_SHA256 is

   for Source_Dirs use ("attest");
   for Source_Files use
     ("attest.ads", "attest-sha256.ads", "attest-sha256.adb");
   for Object_Dir use "../obj/attest-sha256";

   type Build_Kind is ("checks", "release");
   Build : Build_Kind := external ("WORLDLINE_BUILD", "checks");

   Common :=
     ("-gnat2022", "-gnatwa", "-gnatVa", "-gnatf", "-O2", "-g", "-fPIC");

   package Compiler is
      case Build is
         when "checks" =>
            for Default_Switches ("Ada") use Common & ("-gnata");
         when "release" =>
            for Default_Switches ("Ada") use Common;
      end case;
   end Compiler;

end Worldline_Attest_SHA256;
