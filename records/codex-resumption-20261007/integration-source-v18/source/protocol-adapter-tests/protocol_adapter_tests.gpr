with "../core/worldline_core_sources.gpr";
project Protocol_Adapter_Tests is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("test_protocol_adapter.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnata");
   end Compiler;
end Protocol_Adapter_Tests;
