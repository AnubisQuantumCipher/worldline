project Resource_Tests is
   for Source_Dirs use (".", "../core", "../core/attest");
   for Source_Files use
     ("resource_tests.adb", "worldline.ads", "worldline-resources.ads",
      "worldline-resources.adb", "attest.ads", "attest-sha256.ads",
      "attest-sha256.adb");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("resource_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnatf", "-O2", "-g",
         "-fPIC", "-gnata");
   end Compiler;
end Resource_Tests;
