with "../core/worldline_core_sources.gpr";
project Canonical_Artifact_Tests is
   for Source_Dirs use (".");
   for Object_Dir use "../obj/artifact-tests";
   for Exec_Dir use "../obj/artifact-tests";
   for Main use ("test_canonical_artifacts.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnatf", "-O2", "-g", "-gnata");
   end Compiler;
end Canonical_Artifact_Tests;
