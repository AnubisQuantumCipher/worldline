with "../core/worldline_core_sources.gpr";
project Actor_Archive_Controls is
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "../obj/actor-archive-controls";
   for Exec_Dir use "../obj/actor-archive-controls";
   for Main use ("actor_archive_controls.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-g", "-O0");
   end Compiler;
end Actor_Archive_Controls;
