with "../core/worldline_core_sources.gpr";
project Recovery_Protocol_Tests is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("test_protocol.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnatwe", "-gnata");
   end Compiler;
end Recovery_Protocol_Tests;
