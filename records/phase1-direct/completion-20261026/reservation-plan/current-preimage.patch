+    def test_direct_native_admitted_input_aliases_and_rejected_output_layouts(self):
+        rows = [native.comparison(value, "chosen", "ne") for value in ("chosen", "other")]
+        capture = self.ordinary_capture("release", rows)
+        baseline = self.ordinary_abi(capture)[:4]
+        self.assertEqual(baseline, (1, (1, 0), 2, 0))
+        for alias in ("mask", "code", "position"):
+            with self.subTest(alias=alias):
+                self.assertEqual(self.ordinary_abi(capture, alias=alias)[:4], baseline)
+        self.assert_ordinary_refusal_unpublished(capture, expected_status=-1, output_overlap=True)
+        self.assert_ordinary_refusal_unpublished(capture, expected_status=-1, misaligned_code=True)
