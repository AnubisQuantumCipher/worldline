+        status, mask, code, position, _ = self.ordinary_abi(self.ordinary_capture("attach-unit", [row]))
+        self.assertEqual((status, code, mask, position), (1, 2, (2,), 0))
+        raw = json.dumps(self.ordinary_capture("probe", observation=False), separators=(",", ":"))
