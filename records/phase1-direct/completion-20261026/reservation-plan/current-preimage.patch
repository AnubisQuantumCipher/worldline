+    def test_direct_native_control_codes_and_guard_short_circuit(self):
+        for op, facts, expected in (
+                ("gate", {"observation": False}, 1),
+                ("probe", {"observation": True}, 2),
+                ("failure", {"beforeOriginal": {}, "afterOriginal": {}, "resultOriginal": {}}, 2),
+                ("identity-unit", {"unitObservation": {"ne": True, "eq": True}}, 1),
+                ("identity-unit", {"unitObservation": {"ne": False, "eq": False}}, 2),
+                ("guard-release", {"decisionPresent": True, "deferred": False}, 2),
+                ("guard-release", {"decisionPresent": True, "deferred": True}, 1),
+                ("guard-release", {"decisionPresent": False, "deferred": False}, 1)):
+            status, mask, code, position, _ = self.ordinary_abi(self.ordinary_capture(op, **facts))
+            self.assertEqual((status, code, mask, position), (1, expected, (), 0))
+        joined = {"unitObservation": {"eq": True}, "codeObservation": {"eq": True},
+                  "originalState": {}, "stateMember": True}
+        for capture, expected in ((None, 2), ({}, 1)):
+            status, mask, code, position, _ = self.ordinary_abi(
+                self.ordinary_capture("guard-settled", managerCapture=capture, **joined))
+            self.assertEqual((status, code, mask, position), (1, expected, (), 0))
+        self.assert_ordinary_refusal_unpublished(
+            self.ordinary_capture("guard-settled", managerCapture="malformed", **joined))
+        for false_field in ("unitObservation", "codeObservation", "stateMember"):
+            facts = dict(joined)
+            facts[false_field] = False if false_field == "stateMember" else {"eq": False}
+            status, mask, code, position, _ = self.ordinary_abi(
+                self.ordinary_capture("guard-settled", managerCapture="ignored", **facts))
+            self.assertEqual((status, code, mask, position), (1, 1, (), 0))
+        invalid = dict(joined, unitObservation={"eq": False}, codeObservation={"eq": None})
+        self.assert_ordinary_refusal_unpublished(self.ordinary_capture("guard-settled", **invalid))
