+    def test_direct_native_guard_delegates_authentic_manager_capture(self):
+        from worldline.manager_resource_lifecycle import pipe_capture, decide
+        unit = "worldline-11111111-1111-1111-1111-111111111111.service"
+        launcher = SimpleNamespace(returncode=0, args=["/usr/bin/systemd-run", "--user",
+            "--pipe", "--service-type=exec", "--property=KillMode=control-group",
+            "--unit=" + unit, "--", "/usr/bin/true"])
+        manager = SimpleNamespace(systemd_run="/usr/bin/systemd-run")
+        process = SystemdProcess(unit, launcher, manager, launched_at_us=1)
+        for after_failure in (False, True):
+            raw = pipe_capture(manager, process, after_failure=after_failure, returncode=launcher.returncode)
+            accepted = decide(raw)["accepted"]
+            self.assertIs(accepted, not after_failure)
+            capture = self.ordinary_capture("guard-settled", unitObservation={"eq": True},
+                codeObservation={"eq": True}, originalState=native.original("NORMAL_PIPE_COMPLETION"),
+                stateMember=True, managerCapture=raw)
+            status, mask, code, position, _ = self.ordinary_abi(capture)
+            self.assertEqual((status, code, mask, position), (1, 2 if accepted else 1, (), 0))
