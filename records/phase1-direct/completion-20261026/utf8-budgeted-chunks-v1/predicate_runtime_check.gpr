with "chunk_predicate_probe.gpr";
project Predicate_Runtime_Check is
   for Source_Dirs use ("runtime-check");
   for Source_Files use ("predicate_runtime_check.adb");
   for Object_Dir use "runtime-obj";
   for Exec_Dir use "runtime-bin";
   for Main use ("predicate_runtime_check.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatVa", "-gnatf");
   end Compiler;
end Predicate_Runtime_Check;
