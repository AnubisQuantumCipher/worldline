+def render_report(report):
+    rendered = json.dumps(report, sort_keys=True)
+    if len(rendered.encode("ascii")) <= MAX_RESULT:
+        return rendered
+    report["status"] = "FAILED"  # Same fail-closed outcome as v1 overflow.
+    evidence = report.get("mount_evidence")
